{
  "mcpServers": {
    "grill": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/index.mjs"
      ],
      "env": {
        "GRILL_API_KEY": "${user_config.openrouter_api_key}",
        "GRILL_CHECK": "${user_config.jev_quality_check}",
        "JUDGE_MODEL": "${user_config.judge_model}",
        "GRILL_NEWS": "${user_config.show_news}"
      }
    }
  }
}
